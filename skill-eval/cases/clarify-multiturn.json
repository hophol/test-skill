{
  "id": "clarify-multiturn",
  "workspace": "fixtures/clarify/workspace",
  "user_questions": "unavailable",
  "slots": {
    "platform": {
      "keywords": [
        "平台",
        "platform",
        "部署",
        "上线到",
        "环境"
      ],
      "answer": "阿里云 ECS"
    },
    "deadline": {
      "keywords": [
        "截止",
        "deadline",
        "期限",
        "什么时候",
        "哪一天",
        "时间"
      ],
      "answer": "下周五"
    }
  },
  "limits": {
    "max_turns": 4,
    "per_turn_timeout_ms": 180000
  },
  "turns": [
    {
      "user": "帮我把 demo-app 发布上线",
      "assert": {
        "must_ask_user": true,
        "forbid_tools": [
          "write",
          "edit",
          "pwsh",
          "bash"
        ]
      }
    },
    {
      "user": "平台用 {{platform}}，{{deadline}} 之前必须上线",
      "assert": {
        "must_not_ask": true,
        "must_write_file": "plan.md",
        "must_contain": [
          "阿里云 ECS",
          "下周五"
        ]
      }
    }
  ],
  "artifacts": [
    "plan.md"
  ],
  "oracle": {
    "plan.md": "platform: 阿里云 ECS\ndeadline: 下周五\n"
  }
}
